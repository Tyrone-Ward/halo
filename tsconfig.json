{
    "extends": "@tsconfig/node20/tsconfig.json",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "./src",
        "paths": {
            "@/*": ["./src"],
            "@config/*": ["./src/config/*"],
            "@utils/*": ["./src/utils/*"],
            "@middleware/*": ["./src/middleware/*"],
            "@services/*": ["./src/services/*"],
            "@routes/*": ["./src/routes/*"],
            "@models/*": ["./src/models/*"]
        },
        "resolveJsonModule": true,
        "esModuleInterop": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}
